[Desktop Entry]
Type=Application
Name=tbc-analyse
GenericName=TBC Analysis Tool
Comment=Analyse and adjust 4fsc TBC video captures and their metadata
Exec=tbc-analyse %f
Icon=tbc-analyse
Terminal=false
NoDisplay=false
StartupNotify=true
MimeType=application/video-tbc;application/video-tbc-chroma;application/x-tbc-luma;application/x-tbc-chroma;application/x-tbc-metadata;application/x-tbc-metadata-json;
Categories=AudioVideo;Video;
Keywords=tbc;laserdisc;vhs;decode;video;analysis;metadata;
