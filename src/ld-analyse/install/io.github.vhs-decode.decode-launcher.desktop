# OVERRIDE - not a package file. decode-launcher ships from vhs-decode (pipx), not tbc-tools;
# this entry only adds %f and the MimeType= list. decode-desktop-sync installs it into
# $XDG_DATA_HOME/applications, and only when decode-launcher is actually on PATH.
#
# Exec= is a bare command here so the file is portable. A file manager does not necessarily
# have pipx's bindir on PATH, so decode-desktop-sync rewrites this line to the resolved
# absolute path as it installs.
[Desktop Entry]
Version=1.0
Type=Application
Name=Decode Launcher
GenericName=VHS/Video Decode Launcher
Comment=GUI launcher for vhs-decode and related decode tools
Exec=decode-launcher %f
Icon=io.github.vhs-decode.vhs-decode
Terminal=false
MimeType=application/x-rf-video-u8;application/x-rf-video-flac;application/x-rf-hifi-u8;application/x-rf-hifi-flac;application/x-rf-combined-u8;application/x-rf-combined-flac;application/x-rf-flac;
Categories=AudioVideo;Video;
Keywords=vhs;decode;rf;capture;laserdisc;tbc;flac;
StartupNotify=true
